# Postgres connection strings for the "loganjrotc-oss" Supabase project
# (ref: ebdoiwwfvudeawcfncmd, region ca-central-1).
#
# Get [YOUR-PASSWORD] from Supabase -> Project Settings -> Database ->
# Database password. If it was never saved, reset it there — resetting
# is safe as long as you update both values below and the Vercel
# environment variables afterwards.
#
# Pooled (Transaction mode, port 6543) — used by the running app, since
# serverless functions need connection pooling:
DATABASE_URL="postgresql://postgres.ebdoiwwfvudeawcfncmd:[YOUR-PASSWORD]@aws-0-ca-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require"

# Session mode (port 5432) — used only for Prisma migrations.
# This deliberately uses the POOLER host rather than the direct
# db.<ref>.supabase.co host: direct connections are IPv6-only on newer
# Supabase projects, which fails from most home and school networks.
DIRECT_URL="postgresql://postgres.ebdoiwwfvudeawcfncmd:[YOUR-PASSWORD]@aws-0-ca-central-1.pooler.supabase.com:5432/postgres?sslmode=require"

# ─────────────────────────────────────────────────────────────────────
# Supabase API keys  (Settings -> API)
# ─────────────────────────────────────────────────────────────────────
# IMPORTANT: these do NOT replace DATABASE_URL above. Prisma talks raw
# Postgres and needs the database password; these authenticate to the
# REST API, Storage, and Realtime. The app cannot start without a
# working DATABASE_URL regardless of what you set here.
#
# Used by lib/supabase.ts for Storage / Realtime / Edge Functions.
NEXT_PUBLIC_SUPABASE_URL="https://ebdoiwwfvudeawcfncmd.supabase.co"

# Publishable ("anon") key — safe to expose; it ships in the browser
# bundle by design and is only useful alongside RLS policies.
# Newer projects show this as sb_publishable_...; older ones as a JWT.
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Secret ("service_role") key — BYPASSES ROW LEVEL SECURITY.
# This is a full-access database credential. Never prefix it with
# NEXT_PUBLIC_, never commit it, never paste it into a chat window.
SUPABASE_SECRET_KEY=""

# Canonical public origin, used for share-card and canonical URLs.
# Must match Vercel's PRIMARY domain exactly (www vs apex matters).
# Optional — defaults to https://www.loganjrotc.org.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# NextAuth
# In production this must equal the primary domain, e.g.
# https://www.loganjrotc.org — a mismatch breaks the sign-in callback.
NEXTAUTH_URL="http://localhost:3000"
# Generate your own — do NOT reuse this placeholder, and use a different
# value in production than in development:
#   openssl rand -base64 32
# Changing it invalidates every existing session (everyone signs out).
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# Optional: seed a first admin account on `npm run seed`
SEED_ADMIN_EMAIL="admin@example.org"
SEED_ADMIN_PASSWORD="change-me-now"

# ─────────────────────────────────────────────────────────────────────
# Rate limiting — Upstash Redis
# ─────────────────────────────────────────────────────────────────────
# Create a free Redis database at https://console.upstash.com, then copy
# the REST URL and REST TOKEN from its "REST API" tab.
#
# Pick the region closest to where the app runs to keep the round-trip
# short — every limited request makes one call here.
#
# IF THESE ARE UNSET, RATE LIMITING IS DISABLED and requests are allowed
# through (fail-open, so a Redis outage can't lock cadets out). Set both
# before serving production traffic; GET /api/health as an admin reports
# whether limiting is actually active.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ─────────────────────────────────────────────────────────────────────
# Bot protection — Cloudflare Turnstile
# ─────────────────────────────────────────────────────────────────────
# Cloudflare dashboard -> Turnstile -> Add site. Add every hostname you
# serve from, INCLUDING localhost, or the widget won't render in dev.
#
# IF THESE ARE UNSET, the widget is not rendered and verification is
# skipped, so local development works without Cloudflare keys.
#
# Cloudflare's test keys (safe to commit, never block real users):
#   always passes: site 1x00000000000000000000AA
#                  secret 1x0000000000000000000000000000000AA
#   always blocks: site 2x00000000000000000000AB
#                  secret 2x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# ─────────────────────────────────────────────────────────────────────
# First-admin bootstrap  (optional)
# ─────────────────────────────────────────────────────────────────────
# Comma-separated addresses that are granted admin automatically when
# they sign up — but ONLY while the unit has no admin yet. Once the
# first admin exists this is permanently inert.
#
# This app does NOT verify email addresses, so without that zero-admin
# gate "this address gets admin" would mean "whoever registers it first
# gets admin." Keep it in the environment, never in source: this repo
# is public.
#
# Clear this variable once your admin account exists.
BOOTSTRAP_ADMIN_EMAILS=""
